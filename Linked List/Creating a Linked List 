Basic Node Structure 
#include <iostream>
using namespace std;

// Node structure
struct Node {
    int data;       // Data stored in the node
    Node* next;     // Pointer to the next node

    // Constructor
    Node(int value) {
        data = value;
        next = nullptr;
    }
};

Linked List Class 
class LinkedList {
private:
    Node* head; //Pointer to the first node 

public:
    //Constructor
    LinkedList() {
        head = nullptr;
    }

    //Insert at the beginning 
    void insertAtBeginning(int value) {
        Node* newNode = new Node(value);
        newNode->next = head;
        head = newNode;
    }

    //Insert at the end 
    void insertAtEnd(int value) {
        Node* newNode = new Node(value);

        if (head == nullptr) {
            head = newNode;
            return;
        }

        Node* temp = head;
        while (temp->next != nullptr) {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    //Insert at a specific position (0 based index)
    void insertAtPosition(int value, int position) {
        if (position == 0) {
            insertAtBeginning(value);
            return;
        }

        Node* newNode = new Node(value);
        Node* temp = head;

        for (int i = 0; i < position - 1 && temp != nullptr; i++) {
            temp = temp->next;
        }

        if (temp == nullptr) {
            cout << "Position out of bounds" << endl;
            delete newNode;
            return;
        }

        newNode->next = temp->next;
        temp->next = newNode;
    }

    //Delete a node by value 
    void deleteNode(int value) {
        if (head == nullptr) return;

        //If head needs to be deleted 
        if (head->data == value) {
            Node* temp = head;
            head = head->next;
            delete temp;
            return;
        }

        Node* temp = head;
        while (temp->next != nullptr && temp->next->data != value) {
            temp = temp->next;
        }

        if (temp->next == nullptr) {
            cout << "Value not found" << endl;
            return;
        }

        Node* nodeToDelete = temp->next;
        temp->next = temp->next->next;
        delete nodeToDelete;
    }

    //Display the list 
    void display() {
        if (head == nullptr) {
            cout << "List is empty" << endl;
            return;
        }

        Node* temp = head;
        while(temp != nullptr) {
            cout << temp->data << " -> ";
            temp = temp->next;
        }
        cout << "nullptr" << endl;
    }

    //Destructor (imp to free the memory)
    ~LinkedList() {
        Node* current = head;
        while (current != nullptr) {
            Node* next = current->next;
            delete current;
            current = next;
        }
    }

};

int main() {
    LinkedList list;

    //Insert elements 
    list.insertAtEnd(10);
    list.insertAtEnd(20);
    list.insertAtEnd(30);
    list.insertAtBeginning(5);
    list.insertAtPosition(15, 2); //Insert 15 at index 2

    cout << "LinkedList: ";
    list.display(); //Output: 5 -> 10 -> 15 -> 20 -> 30 -> nullptr
    
    //Delete a node 
    list.deleteNode(15);

    cout << "After deleting 15: ";
    list.display(); //Output: 5 -> 10 -> 20 -> 30 -> nullptr

    return 0;
}

Time Complexity:
Insert at beginning: O(1) 
Just update the head pointer. No traversal needed 

Insert at the End: O(n) 
Must traverse the entire list to reach the last node.
Insert at end can be improved to O(1) if you maintain an extra tail pointer

Insert at Position: O(n) 
Traversal up to the given position is required 

Delete by Value (deleteNode): O(n)
Must search for the node (and its previous node)

Display/Traverse(display): O(n) Visits every node once.

Search by Value: O(n) Linear scan of list.

Space Complexity:
Overall Linked List(n nodes): O(n) Each node stores data + one pointer 

Auxiliary space(for operations): O(1) All operations above use only constant number of extra pointers(temp, newNode) No recursion or extra data structure.

Recursive versions: O(n) Recursion depth can be up to n.



