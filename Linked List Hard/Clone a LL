// TC: O(N) 
// We traverse the ll exactly twice.
// N + N = 2N which simplifies to O(N)

// SC: O(N)
// We use unordered_map to store exactly N key-value pairs (Original Nodes -> Copied Nodes)
// which takes extra memory 

class Solution {
public:
    Node* copyRandomList(Node* head) {
        if (head == nullptr) return nullptr;
        
        Node* curr = head;

        //Insert copied nodes directly after original nodes 
        //Eg: A -> B becomes A -> A` -> B -> B`
        while (curr != nullptr) {
            Node* copyNode = new Node(curr->val);
            copyNode->next = curr->next;
            curr->next = copyNode;

            curr = copyNode->next; //Move to the next original node
        }

        curr = head;

        //Assign random pointers for the copied nodes 
        while (curr != nullptr) {
            if (curr->random != nullptr) {
                //The copy's random is the original random's next node(which is the copy of random)
                curr->next->random = curr->random->next;
            }
            curr = curr->next->next; //Skip over the copied node to the next original 
        }

        //Seperate the original and copied list 
        curr = head;
        Node* dummy = new Node(-1);
        Node* copyCurr = dummy;

        while (curr != nullptr) {
            //Extract the copied node 
            copyCurr->next = curr->next;
            copyCurr = copyCurr->next;

            //Restore the original lists next pointer
            curr->next = curr->next->next;

            //Move forward
            curr = curr->next;
        }

        Node* newHead = dummy->next;
        delete dummy; 
        return newHead;
    }
};

TC: O(N)
We traverse the list 3 times (once to insert, once to link randoms, once to separate).
3N operations simplify to a linear time complexity of O(N)

SC: O(1)
We do not use any extra data structure like hash map.
The only extra memory is the nodes we created for the copied list.