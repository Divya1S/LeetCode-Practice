class Solution {
public:
    int beautySum(string s) {
        int n = s.length();
        int totalBeauty = 0;
        
        // i represents the starting index of the substring
        for (int i = 0; i < n; ++i) {
            vector<int> freq(26, 0); // Frequency array for the current starting index
            
            // j represents the ending index of the substring
            for (int j = i; j < n; ++j) {
                freq[s[j] - 'a']++; // Increment the frequency of the current character
                
                int maxF = 0;
                int minF = INT_MAX;
                
                // Find the max and min frequencies in the current substring
                for (int f : freq) {
                    if (f > 0) {
                        maxF = max(maxF, f);
                        minF = min(minF, f);
                    }
                }
                
                // Add the beauty of the current substring to the total
                totalBeauty += (maxF - minF);
            }
        }
        
        return totalBeauty;
    }
};

